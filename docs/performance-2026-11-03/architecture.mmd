flowchart TB
    Browser["浏览器 / 微信<br/>路由按需加载、空闲 30 秒轮询"]
    Edge["Caddy HTTPS<br/>GET 压缩、哈希资源缓存"]
    Browser --> Edge
    subgraph Host["当前公网：单台 2 vCPU / 3499 MiB，Docker Compose"]
      API["API 容器<br/>鉴权、短请求、任务提交"]
      Auth["身份路径<br/>不加载邮件历史"]
      Reads["按用途读取<br/>列表 / 单封原文 / 附件元数据 / 执行历史"]
      Mutations["业务写入<br/>完整快照 + CAS + 提交后响应"]
      PG[("PostgreSQL<br/>业务、任务、版本、Outbox")]
      Redis[("Redis<br/>一次性验证码、会话与临时状态")]
      MQ["RabbitMQ<br/>持久任务通知"]
      Worker["Worker 容器<br/>IMAP / 模型 / OCR<br/>跳过已完成邮件的逐封快照"]
      Scheduler["Scheduler 容器<br/>每分钟检查，邮箱间隔 600 秒"]
      Object[("私有 MinIO / S3 协议<br/>附件字节")]
    end
    Edge --> API
    API --> Auth --> Redis
    Auth -->|用户与撤销校验| PG
    API --> Reads -->|SQL JSONB 投影| PG
    API --> Mutations --> PG
    API -->|归属核验后读文件| Object
    API -->|HTTP 202，持久入队| PG
    PG -->|Outbox| MQ --> Worker
    Scheduler -->|到期派发、在途屏障| PG
    Worker -->|围栏 / 检查点 / CAS| PG
    Worker --> Object
    Worker --> External["真实邮箱 IMAP / 模型 / OCR"]
