node_modules/
dist/
data/
!src/data/
src/data/*
!src/data/competition-evidence.json
work/
*.log
# Generated by `sh deploy/up.sh`; holds per-stack random secrets.
deploy/compose.env
deploy/compose.env.*
!deploy/compose.env.example
# Submission evidence and deploy validation logs are referenced by the delivery docs,
# so they must be committable; every other log stays ignored.
!docs/submission/**/*.log
!deploy/*.log
!deploy/verification/**/*.log
server/.DS_Store

# LaTeX build output for the hackathon report is regenerated from the tracked .tex.
output/
__pycache__/
*.pyc
*.aux
*.out
*.toc

.DS_Store
**/.DS_Store

# Private runtime settings and local credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
