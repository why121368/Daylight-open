{
	email {$DAYLIGHT_ACME_EMAIL}
	# Only TCP 80/443 is published by this topology.
	servers {
		protocols h1 h2
	}
}

{$DAYLIGHT_PUBLIC_HOST} {
  # Compress read payloads and hashed frontend assets; leave streaming mutations alone.
  @compress {
    method GET
    path /assets/* /api/state /api/traces /api/auth/captcha /api/campus-guide/catalog
  }
  encode @compress zstd gzip
	# Caddy manages ACME certificates and HTTP -> HTTPS redirects for this hostname.
	# No request access log: private query strings and email content must not enter logs.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy api:3000 {
		# Deliver assistant SSE chunks immediately. Do not buffer or retry mutations.
		flush_interval -1
		transport http {
			dial_timeout 10s
			response_header_timeout 300s
		}
	}
}
