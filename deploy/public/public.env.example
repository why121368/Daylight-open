# Public routing settings only. No passwords or API keys belong in this file.
# up.sh writes these to <your-compose.env>.public without changing compose.env.
# Use an actual hostname you control; the values below are placeholders.
DAYLIGHT_PUBLIC_HOST=daylight.your-domain.cn
DAYLIGHT_ACME_EMAIL=admin@your-domain.cn
# Optional, pin a compatible Caddy image or digest available to your server.
DAYLIGHT_CADDY_IMAGE=caddy:2.10.2-alpine
# Only when this dedicated subnet conflicts with an existing Docker/VPC route,
# set BOTH values to another private subnet and one unused address inside it.
# Only API and Caddy join this network. API trusts this Caddy address (/32).
# up.sh retains the pair on reruns; CLI flags override exported values and file.
DAYLIGHT_INGRESS_SUBNET=172.30.255.0/29
DAYLIGHT_CADDY_IP=172.30.255.2
